<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/txtOrderProductTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/txtOrderProductPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <EditText
            android:id="@+id/editCustomerName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/customer_name"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/editCustomerPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/customer_phone"
            android:inputType="phone" />

        <Button
            android:id="@+id/btnPickReceipt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pick_receipt"
            android:layout_marginTop="16dp" />

        <ImageView
            android:id="@+id/imgReceiptPreview"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="centerInside"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/receipt_image" />

        <Button
            android:id="@+id/btnSubmitOrder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/submit_order"
            android:layout_marginTop="16dp" />

    </LinearLayout>
</ScrollView>
